---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EXTERNAL_LINKS } from '../consts';
---

<BaseLayout title="Opening Suwatte" description="A link shared from Suwatte.">
  <meta slot="head" name="robots" content="noindex" />

  <div class="open shell">
    <h1 data-heading>Opening Suwatte…</h1>
    <p class="lede" data-message>You are being redirected to Suwatte.</p>

    <div class="open__fallback" data-fallback hidden>
      <p>Nothing happened? Make sure Suwatte is installed, then try again.</p>
      <div class="open__actions">
        <a class="btn" data-open href="#">Open in Suwatte</a>
        {
          EXTERNAL_LINKS.appStore && (
            <a class="btn btn--ghost" href={EXTERNAL_LINKS.appStore} target="_blank" rel="noopener noreferrer">
              Get Suwatte
            </a>
          )
        }
      </div>
    </div>

    <noscript>
      <p class="lede">Turn on JavaScript to open this link in Suwatte.</p>
    </noscript>
  </div>
</BaseLayout>

<script>
  // The link data travels in the fragment, so it never reaches this server. It
  // is the base64url JSON the app reads from suwatte://source-destination?data=…;
  // the app validates it, so this page only checks that it is present.
  const FALLBACK_DELAY_MS = 2000;
  const query = (selector: string) => document.querySelector<HTMLElement>(selector)!;

  const data = location.hash.slice(1);
  if (!/^[A-Za-z0-9_\-+/=]+$/.test(data)) {
    query('[data-heading]').textContent = 'This link is incomplete';
    query('[data-message]').textContent = 'Ask the person who shared it to send it again.';
  } else {
    const appURL = `suwatte://source-destination?data=${encodeURIComponent(data)}`;
    query('[data-open]').setAttribute('href', appURL);
    location.href = appURL;

    // When the app opens, the page is hidden; if it is still showing, offer a retry.
    setTimeout(() => {
      if (document.visibilityState === 'visible') {
        query('[data-fallback]').hidden = false;
      }
    }, FALLBACK_DELAY_MS);
  }
</script>

<style>
  .open {
    max-width: 40rem;
    padding-block: clamp(4rem, 12vh, 8rem) 6rem;
  }

  .open h1 {
    margin-block: 0 1rem;
    font-size: var(--step-4);
    letter-spacing: -0.032em;
  }

  .open__fallback {
    margin-top: 2.5rem;
    color: var(--text-muted);
  }

  .open__fallback[hidden] {
    display: none;
  }

  .open__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
