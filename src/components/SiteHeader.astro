---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE, EXTERNAL_LINKS } from '../consts';

const path = Astro.url.pathname;

// One menu holds the documentation and help destinations.
const guides = [
  {
    label: 'Guides',
    href: '/docs/introduction/',
    hint: 'Set up the app and use it.',
    match: '/docs/',
  },
  {
    label: 'Developers',
    href: '/developers/introduction/',
    hint: 'Write a source with the toolchain.',
    match: '/developers/',
  },
  {
    label: 'Help',
    href: '/help/',
    hint: 'Find help or report a problem.',
    match: '/help/',
  },
];

const menuIsCurrent = guides.some((item) => path.startsWith(item.match));
---

<header class="masthead">
  <div class="masthead__inner shell">
    <a class="brand" href="/">
      <Logo size={26} />
      <span class="brand__word">{SITE.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <div class="menu" data-menu>
        <button
          class="nav__link nav__link--menu"
          type="button"
          aria-expanded="false"
          aria-controls="guides-menu"
          aria-current={menuIsCurrent ? 'true' : undefined}
          data-menu-trigger
        >
          Guides
          <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="m5.5 8 4.5 4.5L14.5 8" />
          </svg>
        </button>

        <div class="menu__panel" id="guides-menu" hidden data-menu-panel>
          <ul>
            {
              guides.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={path.startsWith(item.match) ? 'page' : undefined}
                  >
                    <strong>{item.label}</strong>
                    <span>{item.hint}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <a class="nav__link" href={SITE.patreon} target="_blank" rel="noopener noreferrer">Support Suwatte</a>
      {
        EXTERNAL_LINKS.appStore ? (
          <a class="nav__link nav__link--cta" href={EXTERNAL_LINKS.appStore} target="_blank" rel="noopener noreferrer">
            Download
          </a>
        ) : null
      }
    </nav>

    <div class="masthead__actions">
      <ThemeToggle />
      <button
        class="nav-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-trigger
      >
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
          <path d="M4 7.5h16M4 12h16M4 16.5h16" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
    <ul>
      {
        guides.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li>
        <a href={SITE.patreon} target="_blank" rel="noopener noreferrer">Support Suwatte</a>
      </li>
      {
        EXTERNAL_LINKS.appStore ? (
          <li>
            <a href={EXTERNAL_LINKS.appStore} target="_blank" rel="noopener noreferrer">Download on the App Store</a>
          </li>
        ) : null
      }
    </ul>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 84%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
    margin-inline-end: auto;
  }

  .brand__word {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.42rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.94rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .nav__link:hover,
  .nav__link[aria-current],
  .nav__link[aria-expanded='true'] {
    background: var(--accent-wash);
    color: var(--text);
  }

  .nav__link--cta {
    background: var(--accent);
    color: var(--accent-on);
  }

  .nav__link--cta:hover {
    background: var(--accent-hover);
    color: var(--accent-on);
  }

  .nav__link--menu svg {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.18s ease;
  }

  .nav__link--menu[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* ------------------------------- the menu ------------------------------- */

  .menu {
    position: relative;
  }

  .menu__panel {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: calc(100% + 0.5rem);
    width: 17rem;
    padding: 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: var(--shadow);
  }

  .menu__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .menu__panel a {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    text-decoration: none;
    transition: background-color 0.14s ease;
  }

  .menu__panel a:hover,
  .menu__panel a:focus-visible {
    background: var(--accent-wash);
  }

  .menu__panel a[aria-current='page'] strong {
    color: var(--accent);
  }

  .menu__panel strong {
    font-family: var(--font-ui);
    font-size: 0.94rem;
    font-weight: 600;
  }

  .menu__panel span {
    color: var(--text-faint);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* ------------------------------ mobile nav ------------------------------ */

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-trigger {
    display: none;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .nav-trigger svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .nav-trigger:hover {
    background: var(--accent-wash);
    color: var(--text);
  }

  .mobile-nav {
    border-top: 1px solid var(--border);
    background: var(--bg-raised);
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter) 0.9rem;
  }

  .mobile-nav a {
    display: block;
    padding: 0.65rem 0.2rem;
    color: var(--text);
    font-family: var(--font-ui);
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 44rem) {
    .nav {
      display: none;
    }

    .nav-trigger {
      display: grid;
    }
  }
</style>

<script>
  // The Guides menu.
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const trigger = menu?.querySelector<HTMLButtonElement>('[data-menu-trigger]');
  const panel = menu?.querySelector<HTMLElement>('[data-menu-panel]');

  if (menu && trigger && panel) {
    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    trigger.addEventListener('click', () => {
      setOpen(trigger.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (trigger.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      trigger.focus();
    });

    // Leaving the menu by keyboard closes it.
    menu.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (!menu.contains(document.activeElement)) setOpen(false);
      }, 0);
    });
  }

  // The mobile panel.
  const navTrigger = document.querySelector<HTMLButtonElement>('[data-nav-trigger]');
  const mobilePanel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  navTrigger?.addEventListener('click', () => {
    const open = navTrigger.getAttribute('aria-expanded') === 'true';
    navTrigger.setAttribute('aria-expanded', String(!open));
    if (mobilePanel) mobilePanel.hidden = open;
  });
</script>
