---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The hero gallery. One large screenshot with a row of thumbnails below it.
 *
 * Each entry can carry a `src`. Entries without one show a labelled
 * placeholder, so the gallery is usable before the real screenshots exist.
 */

export interface GalleryShot {
  id: string;
  label: string;
  src?: ImageMetadata;
  /** The source already includes an official Apple product bezel. */
  framed?: boolean;
}

interface Props {
  shots: GalleryShot[];
}

const { shots } = Astro.props;
---

<div class="gallery" data-gallery>
  <div class="gallery__stage">
    {
      shots.map((shot, index) => (
        <figure
          class="gallery__panel"
          data-panel={shot.id}
          data-active={index === 0 ? '' : undefined}
        >
          <div class:list={['gallery__frame', { 'gallery__frame--device': shot.framed }]}>
            {shot.src ? (
              <Image
                class="gallery__image"
                src={shot.src}
                alt={shot.label}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            ) : (
              <div class="gallery__placeholder">
                <span class="gallery__tag">Screenshot</span>
                <span class="gallery__label">{shot.label}</span>
              </div>
            )}
          </div>
        </figure>
      ))
    }
  </div>

  <div class="gallery__thumbs" role="group" aria-label="Screenshots">
    {
      shots.map((shot, index) => (
        <button
          class="thumb"
          type="button"
          data-thumb={shot.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span class:list={['thumb__frame', { 'thumb__frame--device': shot.framed }]}>
            {shot.src ? (
              <Image class="thumb__image" src={shot.src} alt="" loading="lazy" />
            ) : (
              <span class="thumb__placeholder" />
            )}
          </span>
          <span class="thumb__name">{shot.label}</span>
        </button>
      ))
    }
  </div>
</div>

<style>
  .gallery {
    display: grid;
    gap: 1rem;
  }

  .gallery__stage {
    display: grid;
    justify-items: center;
  }

  .gallery__panel {
    grid-area: 1 / 1;
    margin: 0;
    width: min(100%, 15.5rem);
    display: none;
  }

  .gallery__panel[data-active] {
    display: block;
  }

  .gallery__frame {
    aspect-ratio: 9 / 19.5;
    border: 1px solid var(--panel-edge);
    border-radius: var(--radius-xl);
    background: var(--panel-face);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .gallery__frame--device {
    aspect-ratio: 1350 / 2760;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    overflow: visible;
  }

  .gallery__frame--device .gallery__image {
    object-fit: contain;
    filter: drop-shadow(0 1.1rem 1.4rem rgb(0 0 0 / 0.28));
  }

  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__placeholder {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.6rem;
    height: 100%;
    padding: 1.2rem;
    text-align: center;
    background-image: repeating-linear-gradient(
      -45deg,
      var(--accent-wash) 0 10px,
      transparent 10px 20px
    );
  }

  .gallery__tag {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-on);
    font-family: var(--font-ui);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gallery__label {
    max-width: 20ch;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .gallery__thumbs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .thumb {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    width: 4.4rem;
    padding: 0.3rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .thumb:hover {
    background: var(--accent-wash);
  }

  .thumb[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .thumb__frame {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    border: 1px solid var(--panel-edge);
    border-radius: 7px;
    background: var(--panel-face);
    overflow: hidden;
  }

  .thumb__frame--device {
    aspect-ratio: 1350 / 2760;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .thumb__frame--device .thumb__image {
    object-fit: contain;
  }

  .thumb__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb__placeholder {
    display: block;
    height: 100%;
    background-image: repeating-linear-gradient(
      -45deg,
      var(--accent-wash) 0 6px,
      transparent 6px 12px
    );
  }

  .thumb__name {
    color: var(--text-faint);
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
  }

  .thumb[aria-pressed='true'] .thumb__name {
    color: var(--accent);
  }

  @media (max-width: 38rem) {
    .gallery__thumbs {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scrollbar-width: thin;
      padding-block-end: 0.35rem;
    }

    .thumb {
      flex: 0 0 4.15rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const panels = [...gallery.querySelectorAll<HTMLElement>('[data-panel]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const show = (thumb: HTMLButtonElement) => {
      const id = thumb.dataset.thumb;
      if (!id) return;

      panels.forEach((panel) => {
        if (panel.dataset.panel === id) panel.setAttribute('data-active', '');
        else panel.removeAttribute('data-active');
      });

      thumbs.forEach((other) => {
        other.setAttribute('aria-pressed', String(other === thumb));
      });
    };

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        if (document.startViewTransition && !reduced.matches) {
          document.startViewTransition(() => show(thumb));
        } else {
          show(thumb);
        }
      });
    });
  });
</script>
