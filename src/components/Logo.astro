---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
  /** Rendered edge length in pixels. The source image is square. */
  size?: number;
  class?: string;
}

const { size = 26, class: className } = Astro.props;
---

<Image
  class={className}
  src={logo}
  alt=""
  width={size}
  height={size}
  densities={[1, 2]}
  loading="eager"
  style={`width:${size}px;height:${size}px`}
/>
